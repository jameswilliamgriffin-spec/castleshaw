{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/v2/video/frames/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/v2/",
      "permanent": false
    },
    {
      "source": "/v1",
      "destination": "/v2/",
      "permanent": true
    },
    {
      "source": "/v1/:path*",
      "destination": "/v2/",
      "permanent": true
    },
    {
      "source": "/advice-and-guidance.html",
      "destination": "/v2/advice-and-guidance/",
      "permanent": true
    },
    {
      "source": "/what-we-do.html",
      "destination": "/v2/activities/",
      "permanent": true
    },
    {
      "source": "/where-we-are.html",
      "destination": "/v2/about/where-we-are/",
      "permanent": true
    },
    {
